---
import type { ProseParagraph } from "../lib/prose";

interface Props {
  paragraphs: ProseParagraph[];
}

const { paragraphs } = Astro.props;
---

{paragraphs.map((paragraph) =>
  typeof paragraph === "string" ? (
    <p>{paragraph}</p>
  ) : (
    <p>
      {paragraph.map((part) =>
        typeof part === "string" ? part : <a href={part.href}>{part.text}</a>,
      )}
    </p>
  ),
)}
