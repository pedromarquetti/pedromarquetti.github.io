---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../i18n/locales";
import { localeLink, t } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={t(locale, "site.title")}
  description={t(locale, "site.description")}
>
  <section class="hero">
    <h1>{t(locale, "hero.greeting")}</h1>
    <p class="lead">{t(locale, "hero.lead")}</p>
    <div class="hero-actions">
      <a class="button" href={localeLink(locale, "projects")}>
        {t(locale, "cta.projects")}
      </a>
      <a class="button button-secondary" href={localeLink(locale, "journey")}>
        {t(locale, "cta.journey")}
      </a>
    </div>
  </section>
</BaseLayout>
