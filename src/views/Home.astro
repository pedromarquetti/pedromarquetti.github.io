---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactLinks from "../components/ContactLinks.astro";
import Icon from "../components/Icon.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import type { Locale } from "../i18n/locales";
import { localeLink, t } from "../i18n/utils";
import { journeySteps } from "../lib/journey";
import { getFeaturedProjects } from "../lib/projects";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = await getFeaturedProjects();
const journeyPreview = journeySteps.slice(0, 4);
---

<BaseLayout
  locale={locale}
  title={t(locale, "site.title")}
  description={t(locale, "site.description")}
>
  <section class="hero">
    <h1>{t(locale, "hero.greeting")}</h1>
    <p class="lead">{t(locale, "hero.lead")}</p>
    <div class="hero-actions">
      <a class="button" href={localeLink(locale, "projects")}>
        {t(locale, "cta.projects")}
      </a>
      <a class="button button-secondary" href={localeLink(locale, "journey")}>
        {t(locale, "cta.journey")}
      </a>
      <a class="button button-secondary" href="#contact">
        {t(locale, "cta.contact")}
      </a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="about-heading">
    <div class="section-header">
      <h2 id="about-heading">{t(locale, "section.about")}</h2>
      <a class="section-link" href={localeLink(locale, "about")}>
        {t(locale, "section.aboutLink")}
        <Icon name="arrow-right" class="icon" />
      </a>
    </div>
    <p>{t(locale, "section.description")}</p>
  </section>

  <section class="home-section" aria-labelledby="featured-heading">
    <div class="section-header">
      <h2 id="featured-heading">{t(locale, "section.featured")}</h2>
      <a class="section-link" href={localeLink(locale, "projects")}>
        {t(locale, "projects.viewAll")}
        <Icon name="arrow-right" class="icon" />
      </a>
    </div>
    <ProjectGrid projects={projects} locale={locale} />
  </section>

  <section class="home-section" aria-labelledby="journey-heading">
    <div class="section-header">
      <h2 id="journey-heading">{t(locale, "section.journey")}</h2>
      <a class="section-link" href={localeLink(locale, "journey")}>
        {t(locale, "section.journeyLink")}
        <Icon name="arrow-right" class="icon" />
      </a>
    </div>
    <ol class="journey-preview" role="list">
      {journeyPreview.map((step, index) => (
        <li data-kind={step.kind}>
          <span class="journey-preview-marker" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <span class="journey-preview-title">{step.title[locale]}</span>
          {step.kind !== "past" && (
            <span class="timeline-badge">
              {t(
                locale,
                step.kind === "present" ? "timeline.present" : "timeline.goal",
              )}
            </span>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="home-section" id="contact" aria-labelledby="contact-heading">
    <div class="section-header">
      <h2 id="contact-heading">{t(locale, "contact.title")}</h2>
    </div>
    <p>{t(locale, "contact.lead")}</p>
    <ContactLinks locale={locale} />
  </section>
</BaseLayout>
