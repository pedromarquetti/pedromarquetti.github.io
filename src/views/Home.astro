---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import type { Locale } from "../i18n/locales";
import { localeLink, t } from "../i18n/utils";
import { getFeaturedProjects } from "../lib/projects";
import Icon from "../components/Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const projects = await getFeaturedProjects();
---

<BaseLayout
  locale={locale}
  title={t(locale, "site.title")}
  description={t(locale, "site.description")}
>
  <section class="hero">
    <h1>{t(locale, "hero.greeting")}</h1>
    <p class="lead">{t(locale, "hero.lead")}</p>
    <div class="hero-actions">
      <a class="button" href={localeLink(locale, "projects")}>
        {t(locale, "cta.projects")}
      </a>
      <a class="button button-secondary" href={localeLink(locale, "journey")}>
        {t(locale, "cta.journey")}
      </a>
    </div>
  </section>

  <section class="home-section">
    <div class="section-header">
      <h2>{t(locale, "section.about")}</h2>
      <a class="section-link" href={localeLink(locale, "about")}>
        {t(locale, "projects.viewAll")}
        <!-- TODO: make this icon the same size of the 'a' tag text + make it inline 'View all projects ->' -->
        <Icon
          name="arrow-right"
          class="icon"
          style="display: flex; margin: auto; text-align: center;  max-width: 20%; max-height: 20%;"
        />
      </a>
    </div>
    <p>{t(locale, "section.description")}</p>
  </section>

  <section class="home-section" aria-labelledby="featured-heading">
    <div class="section-header">
      <h2 id="featured-heading">{t(locale, "section.featured")}</h2>
      <a class="section-link" href={localeLink(locale, "projects")}>
        {t(locale, "projects.viewAll")}
        <!-- TODO: make this icon the same size of the 'a' tag text + make it inline 'View all projects ->' -->
        <Icon
          name="arrow-right"
          class="icon"
          style="display: block; margin: auto; text-align: center;  max-width: 20%; max-height: 20%;"
        />
      </a>
    </div>
    <ProjectGrid projects={projects} locale={locale} />
  </section>
</BaseLayout>
