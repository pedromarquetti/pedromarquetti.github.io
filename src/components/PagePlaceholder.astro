---
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { LANG_TAGS, type Locale } from "../i18n/locales";
import { getAlternates, localePath, t } from "../i18n/utils";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const pathname = Astro.url.pathname;
const base = Astro.site ?? Astro.url;
const absoluteUrl = (path: string) => new URL(path, base).toString();
const title = t(locale, "site.title");
const description = t(locale, "site.description");
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={LANG_TAGS[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {getAlternates(pathname).map(({ locale: alternate, path }) => (
      <link
        rel="alternate"
        hreflang={LANG_TAGS[alternate]}
        href={absoluteUrl(path)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={absoluteUrl(localePath("en", pathname))}
    />
  </head>
  <body>
    <header>
      <a href={getRelativeLocaleUrl(locale, "")}>{t(locale, "nav.home")}</a>
      <LanguageSwitcher locale={locale} />
    </header>
    <main id="main">
      <h1>{t(locale, "hero.greeting")}</h1>
      <p>{t(locale, "hero.lead")}</p>
      <p>{t(locale, "placeholder.body")}</p>
    </main>
    <footer>
      <p>{t(locale, "footer.rights", { year })}</p>
    </footer>
  </body>
</html>
