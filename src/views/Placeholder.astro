---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../i18n/locales";
import type { UIKey } from "../i18n/ui";
import { t } from "../i18n/utils";

interface Props {
  locale: Locale;
  headingKey: UIKey;
  titleKey: UIKey;
  descriptionKey: UIKey;
}

const { locale, headingKey, titleKey, descriptionKey } = Astro.props;
---

<BaseLayout
  locale={locale}
  title={t(locale, titleKey)}
  description={t(locale, descriptionKey)}
>
  <h1>{t(locale, headingKey)}</h1>
  <p>{t(locale, "placeholder.body")}</p>
</BaseLayout>
